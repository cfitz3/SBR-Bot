# ─────────────────────────────────────────────────────────────────────────────
# SBR Guild Platform — environment template. Copy to `.env` and fill in.
# `packages/config` validates these at boot and fails fast on missing/invalid.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # trace | debug | info | warn | error

# Datastores
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sbrbot?schema=public
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=sbr:                 # namespace for all Redis keys (see REDIS_KEYSPACE.md)

# Discord — member (bridge) bot
DISCORD_BRIDGE_TOKEN=your_bridge_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_discord_server_id          # single-guild bridge target
# No channel ids here. Every slot — bridge, staff, log, applications, events,
# LFG, tickets, milestones, leaderboard, modlog — is bound in the database
# (GuildChannelBinding) via `/set-channel` or the panel's Mapping page. After
# `npm run db:seed`, bind the bridge channel before expecting a relay.

# Discord — admin bot (separate token / blast radius, see ADMIN_BOT.md)
DISCORD_ADMIN_TOKEN=your_admin_bot_token_here

# Internal API — the admin bot's loopback channel to the panel and the workers.
# The admin bot is the only process holding a Discord gateway cache, so this is
# where the channel/role/member dropdowns and the Discord-side member scan get
# their data. Leave it unset and everything still runs, in a degraded shape that
# is easy to mistake for a bug: the panel's pickers fall back to raw-ID text
# fields, Moderation's member lookup says "directory unavailable", and the
# `discord-member-sync` job skips every run, so the Members page shows the
# in-game side only. Set it on both the bot and the panel — it is the only
# authentication this API has.
#
#   openssl rand -hex 32
#
# Two further requirements, neither of which is visible from code:
#   1. Enable the **Server Members** privileged intent for the admin bot's
#      application in the Discord developer portal, or the gateway refuses the
#      connection outright.
#   2. Keep the bind on loopback unless you know otherwise — this API answers
#      "list every member of this server" to anyone holding the token.
INTERNAL_API_TOKEN=
INTERNAL_API_PORT=3011
# Where the panel and the workers dial it. Defaults to http://127.0.0.1:<port>.
# INTERNAL_API_URL=http://127.0.0.1:3011

# The bridge bot's own loopback API, sharing INTERNAL_API_TOKEN. Ticket channels
# live in the community server, so panel "Publish" and admin /tickets reach the
# bridge process rather than the admin one.
BRIDGE_API_PORT=3012
# BRIDGE_API_URL=http://127.0.0.1:3012

# Discord OAuth — web panel (see WEB_PANEL.md)
DISCORD_OAUTH_CLIENT_ID=your_oauth_client_id
DISCORD_OAUTH_CLIENT_SECRET=your_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=change_me_min_32_chars_long_secret_value

# Hypixel API (see HYPIXEL_DATA_LAYER.md, and HYPIXEL_COMPLIANCE.md for the
# policy this install runs under)
HYPIXEL_API_KEY=your_hypixel_api_key_here

# Which API policy regime: `personal` (the guild-activity exception — one
# owner-registered key, non-production, at most one request per player per hour)
# or `production` (a granted production-tier key). Defaults to `personal`, which
# is what ships; leaving it unset is the safe direction. Setting `production`
# without a key on file is a boot failure.
# HYPIXEL_KEY_MODE=personal

# SkyKings scammer database (join screening, see BRIDGE_BOT.md §6A).
# Optional: without it the scammer check answers UNKNOWN, and the default policy
# holds those requests for a human rather than letting them through.
# A credential only — the screening policy itself is panel-edited, never here.
SKYKINGS_API_KEY=your_skykings_api_key_here

# Ops reporting (the watchtower and the log shipper, see OPERATIONS.md).
# Raw Discord channel ids in the staff server, not panel-configured slots: these
# alerts have to survive the database being the thing that is down. Leave both
# unset in development and the platform simply says nothing.
OPS_ALERT_CHANNEL_ID=
# Optional. Errors go to the alert channel when this is unset.
OPS_ERROR_CHANNEL_ID=

# In-game bridge (Mineflayer — ban risk, see BRIDGE_BOT.md / INTEGRATIONS.md)
MC_HOST=mc.hypixel.net
MC_PORT=25565
MC_USERNAME=your_bridge_account_email

# Web panel
WEB_PANEL_PORT=3000

# How a browser reaches the panel. Decides cookie `Secure`, the origin the CSRF
# check compares against, and whether this process terminates TLS itself.
# Defaults to `https` when unset — running without TLS is always a deliberate act.
#
#   https  (default) — Secure cookies. TLS is either terminated by a reverse
#                      proxy in front of this port, or in-process via the
#                      WEB_PANEL_TLS_* pair below.
#   http            — plaintext, for a VPS on a bare IP with no certificate yet.
#                      Session cookies travel in the clear; in production this
#                      additionally requires WEB_PANEL_ALLOW_INSECURE=true.
WEB_PANEL_SCHEME=https

# Absolute origin the panel is served on, e.g. http://203.0.113.10:3000.
# Set when the panel sits behind a proxy or on a bare IP; when unset it is
# derived from DISCORD_OAUTH_REDIRECT_URI, then from the local bind address.
# Its scheme must agree with WEB_PANEL_SCHEME.
# WEB_PANEL_PUBLIC_URL=

# Acknowledge running production over plaintext (only read when scheme=http).
# WEB_PANEL_ALLOW_INSECURE=false

# Terminate TLS in this process instead of behind a proxy. Set both or neither.
# WEB_PANEL_TLS_CERT=/etc/ssl/certs/panel.pem
# WEB_PANEL_TLS_KEY=/etc/ssl/private/panel.key

# ─── ChatTriggers module (development only) ──────────────────────────────────
# Where `npm run ctjs:dev` installs ctjs-module/sbr-dungeon-tracker. Only needed
# on a machine that also runs Minecraft, and only for developing the module —
# nothing at runtime reads this. Unset falls back to the vanilla launcher's
# path for your OS, which is wrong for MultiMC, Prism and Modrinth instances.
# CTJS_MODULES_DIR=C:\Users\you\AppData\Roaming\.minecraft\config\ChatTriggers\modules
