# SBR-Guide — secrets and process wiring.
#
# This file holds credentials and where things are, and nothing else. Anything
# an operator might want to change while the bot is running lives in the
# database instead, so changing it is not a restart and a redeploy.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Datastores ──────────────────────────────────────────────────────────────
# Ports match docker-compose.yml, which binds both to loopback and offsets them
# so this stack can run beside another local Postgres/Redis.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sbrguide
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=guide:

# ── Discord ─────────────────────────────────────────────────────────────────
# The bot application token. Leave it unset and the process composes, reports
# that it has nothing to serve, and exits — which is a useful way to verify the
# wiring without credentials.
DISCORD_GUIDE_TOKEN=your_guide_bot_token_here

# ── Hypixel ─────────────────────────────────────────────────────────────────
# The key is read here once and reaches exactly one construction site, in
# src/composition.ts. It travels as an `API-Key` header and never in a URL, so
# it cannot end up in a log line, a proxy access log, or a referrer.
HYPIXEL_API_KEY=your_hypixel_api_key_here

# Which policy regime this install runs under (COMPLIANCE.md §0):
#   personal    — a personal key under the guild-activity exception. At most one
#                 request per player per hour, enforced against our own clock.
#   production  — a granted production-tier key; the cache TTL is then the only
#                 per-player floor.
# The default is `personal`, so an install that never sets this is the
# restrictive one rather than the permissive one.
HYPIXEL_KEY_MODE=personal
