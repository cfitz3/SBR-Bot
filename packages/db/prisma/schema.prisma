// SBR Guild Platform — data model. See DOMAIN_MODEL.md for the narrative version.
// Postgres is the source of truth; Redis mirrors hot/ephemeral state (REDIS_KEYSPACE.md).
//
// Datasource URL is provided via prisma.config.ts (CLI) and the pg driver adapter
// (runtime, src/client.ts), matching the Prisma 7 driver-adapter model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum GuildStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberRole {
  MEMBER
  MODERATOR
  OFFICER
  ADMIN
  OWNER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  LEFT
  BANNED
}

enum LinkStatus {
  PENDING
  VERIFIED
  REJECTED
  UNLINKED
}

enum LinkVerificationMethod {
  HYPIXEL_SOCIAL // Discord field on the Hypixel profile (COMMANDS.md /link)
  MANUAL
}

enum SkyblockGameMode {
  NORMAL
  IRONMAN
  STRANDED
  BINGO
}

enum PermSubjectType {
  DISCORD_ROLE
  DISCORD_USER
  GUILD_RANK
}

enum BridgeCapability {
  RELAY_MESSAGE
  RUN_COMMAND
  MENTION
  TICKET_MANAGE
  BYPASS_FILTER
  BYPASS_COOLDOWN
  ADMIN
}

/// Where a canned reply's auto-pattern is allowed to fire.
///
/// `TICKET` is the default so that every tag written before this existed keeps
/// its old blast radius. Opting one into `SERVER` is a deliberate act: it turns
/// a staff shortcut into something that answers members in open channels.
enum TagScope {
  TICKET
  SERVER
  ANY
}

enum WordMatchType {
  EXACT
  SUBSTRING
  REGEX
  WILDCARD
}

enum WordAction {
  BLOCK
  FLAG
  REPLACE
  SHADOW_MUTE
}

enum SourceContext {
  BRIDGE
  DISCORD
  INGAME
}

enum InfractionType {
  SPAM
  PROFANITY
  HARASSMENT
  ADVERTISING
  CHEATING
  RULE_BREAK
  OTHER
}

enum InfractionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InfractionStatus {
  OPEN
  ACTIONED
  EXPIRED
  APPEALED
  OVERTURNED
}

enum ModActionType {
  WARN
  MUTE
  UNMUTE
  KICK
  BAN
  UNBAN
  NOTE
  ROLE_CHANGE
  GUILD_EXPEL
}

// `enum TicketCategory` was here. Categories are a model now: a guild writes its
// own, with its own staff roles, questions and limits, and the five former enum
// values are seeded as ordinary rows so nothing a guild had is lost.

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EventType {
  DUNGEON
  SLAYER
  FISHING
  MINING
  GIVEAWAY
  MEETING
  CUSTOM
}

enum EventStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum RSVPState {
  GOING
  MAYBE
  NOT_GOING
  WAITLIST
}

enum LFGActivity {
  DUNGEONS
  SLAYERS
  KUUDRA
  FISHING
  MINING
  OTHER
}

enum LFGStatus {
  OPEN
  FULL
  EXPIRED
  CLOSED
}

enum MilestoneType {
  SKYBLOCK_LEVEL
  SKILL_LEVEL
  CATACOMBS_LEVEL
  SLAYER_TIER
  NETWORTH_THRESHOLD
  COLLECTION
  CUSTOM
}

/// How much of a deal an achievement is. Guild-set, because two guilds of
/// different sizes genuinely disagree about what Catacombs 35 means.
///
/// There is no matching Category enum: a category follows from the metric
/// (`categoryOfMetric` in `@sbr/shared-types`), and storing it beside the metric
/// would create a row that can contradict itself.
enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum SnapshotSource {
  SCHEDULED
  ON_DEMAND
  EVENT_TRACKED // sub-hourly cadence for progression-event leaderboards (WORKERS.md §2.5)
  BACKFILL
}

enum CommandSurface {
  BRIDGE_BOT
  ADMIN_BOT
  WEB_PANEL
  INGAME
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

// ─────────────────────────── Identity & Accounts ───────────────────────────

model DiscordUser {
  id         String    @id @default(cuid())
  discordId  String    @unique
  username   String?
  globalName String?
  avatarHash String?
  isStaff    Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  linkedAccounts LinkedAccount[]
  memberships    GuildMember[]

  @@index([discordId])
}

model MinecraftAccount {
  id                   String    @id @default(cuid())
  uuid                 String    @unique
  currentIgn           String?
  ignHistoryCachedAt   DateTime?
  hypixelLastFetchedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  linkedAccounts   LinkedAccount[]
  selectedProfiles SelectedSkyblockProfile[]
  snapshots        ProfileSnapshot[]
  milestones       Milestone[]
  goals            ProgressionGoal[]

  @@index([uuid])
  @@index([currentIgn])
}

model LinkedAccount {
  id                 String                 @id @default(cuid())
  discordUserId      String
  minecraftAccountId String
  status             LinkStatus             @default(PENDING)
  verificationMethod LinkVerificationMethod @default(HYPIXEL_SOCIAL)
  isPrimary          Boolean                @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  discordUser      DiscordUser      @relation(fields: [discordUserId], references: [id], onDelete: Cascade)
  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@unique([discordUserId, minecraftAccountId])
  @@index([status])
}

// ─────────────────────────── Guild & Membership ───────────────────────────

model Guild {
  id             String      @id @default(cuid())
  hypixelGuildId String?     @unique
  name           String
  tag            String?
  discordGuildId String      @unique
  status         GuildStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  config           GuildConfig?
  channels         GuildChannelBinding[]
  settings         GuildSetting[]
  members          GuildMember[]
  memberCache      GuildMemberCache[]
  gexpDaily        GuildGexpDaily[]
  scans            GuildScan[]
  permissions      BridgePermission[]
  wordlist         WordlistEntry[]
  infractions      Infraction[]
  modActions       ModerationAction[]
  tickets          Ticket[]
  applications     Application[]
  events           Event[]
  lfgPosts         LFGPost[]
  perms            PermGroup[]
  xpEvents         XpEvent[]
  xpBalances       XpBalance[]
  xpLevelUps       XpLevelUp[]
  reminders        Reminder[]
  goals            ProgressionGoal[]
  xpSources        XpSourceConfig[]
  activityDaily    ActivityDaily[]
  screenings       GuildJoinScreening[]
  subscriptions    NotificationSubscription[]
  milestoneDefs    MilestoneDefinition[]
  ticketSettings   TicketSettings?
  ticketCategories TicketCategory[]
  ticketPanels     TicketPanel[]
  ticketTags       TicketTag[]
  roleGrants       RoleGrant[]

  @@index([discordGuildId])
}

/// Discord roles this platform handed out, and the rule that authorised each.
///
/// The ledger is what makes revocation safe. Auto-roles only ever remove a role
/// with an open row here, so a role somebody was given by hand, by another bot,
/// or by a rule that has since been deleted is never stripped by a reconcile.
///
/// Soft-deleted rather than dropped: "we gave this and later took it back" is
/// the question staff actually ask when somebody complains, and a deleted row
/// cannot answer it.
model RoleGrant {
  id        String    @id @default(cuid())
  guildId   String
  discordId String
  roleId    String
  /// The `roles.auto` rule key that granted it, or `manual` for a staff grant.
  /// Only the rule that granted a role may take it back, which is why this is
  /// part of the row's identity rather than a note on it.
  ruleKey   String
  /// Free text for the audit trail — who asked, or which job.
  reason    String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// The reconciler's read: every open grant for one member.
  @@index([guildId, discordId])
  /// Uniqueness is enforced by a *partial* index over open rows only, declared
  /// in the migration rather than here — Prisma cannot express `WHERE revokedAt
  /// IS NULL`, and a total unique constraint would make a revoked grant
  /// permanently unrepeatable.
  @@index([guildId, roleId])
}

model GuildMember {
  id            String       @id @default(cuid())
  guildId       String
  discordUserId String
  guildRank     String?
  /// Per-server display name, which is what staff actually see in Discord and
  /// therefore what they search by. Distinct from DiscordUser.globalName, which
  /// is the same everywhere; null means they have not set one here.
  nickname      String?
  /// The Discord roles this member holds, mirrored by `discord-member-sync`.
  /// Stored rather than read from the gateway because `hasCapability` runs on
  /// every relayed message, and a role check that needed a bot round trip would
  /// put the gateway in the relay's hot path.
  roleIds       String[]     @default([])
  /// The manual assignment `/set-role type:member` writes. Combined with the
  /// Discord-role and guild-rank mappings by taking the highest — see
  /// `resolveMemberRole` in @sbr/guild-config.
  role          MemberRole   @default(MEMBER)
  /// An explicit level that wins outright, and the only way *down*: every other
  /// source combines by taking the max, so without this a demotion could be
  /// outvoted by a Discord role the member still holds.
  roleOverride  MemberRole?
  status        MemberStatus @default(ACTIVE)
  joinedAt      DateTime?
  leftAt        DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  guild       Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUser DiscordUser @relation(fields: [discordUserId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordUserId])
  @@index([guildId, status])
  @@index([guildId, role])
  @@index([guildId, nickname])
}

model SelectedSkyblockProfile {
  id                 String           @id @default(cuid())
  minecraftAccountId String
  guildId            String? // null = global selection
  profileId          String
  cuteName           String?
  gameMode           SkyblockGameMode @default(NORMAL)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@unique([minecraftAccountId, guildId])
  @@index([minecraftAccountId, isActive])
}

// ─────────────────────────── Config & Permissions ───────────────────────────

/// One channel binding per (guild, slot).
///
/// Replaced the fixed `*ChannelId` columns on GuildConfig: adding a slot is a
/// row rather than a migration, which is what lets the panel own the full set of
/// guild-specific channels instead of some of them living in `.env`. Those
/// columns are gone as of 20260811150000_drop_legacy_channel_columns — this
/// table is now the only place a channel is recorded.
model GuildChannelBinding {
  id        String   @id @default(cuid())
  guildId   String
  /// See CONFIG_CHANNEL_SLOTS in @sbr/shared-types. Deliberately a string rather
  /// than an enum: a new slot should not need a database migration, and the
  /// value is narrowed by `isConfigChannelSlot` at every entry point.
  slot      String
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, slot])
  @@index([guildId])
}

/// Typed-at-the-edge admin settings: embed templates, dropdown layouts, and the
/// other per-guild payloads that would each otherwise be a column. Rows are
/// written only by the panel and the admin bot; readers own the shape and treat
/// an absent or malformed value as "use the platform default".
model GuildSetting {
  id        String   @id @default(cuid())
  guildId   String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
}

/// Rolling snapshot of the *in-game* guild roster, refreshed by `guild-scan`.
///
/// Distinct from GuildMember, which is platform membership keyed by Discord
/// account: this table holds everyone in the Hypixel guild, including the many
/// who have never linked a Discord account, and is what perm roster autofill,
/// leaderboards and XP read so none of them costs a live Hypixel call.
///
/// Rows older than the cache TTL (6h) are stale, not wrong — a reader may serve
/// them while saying so, which is far better than blocking on the API.
model GuildMemberCache {
  id          String    @id @default(cuid())
  guildId     String
  uuid        String
  /// Resolved from Mojang opportunistically; null until a lookup succeeds, since
  /// the guild endpoint returns uuids only.
  ign         String?
  guildRank   String?
  joinedAt    DateTime?
  /// Sum of the ~7-day expHistory window at the time of the scan.
  weeklyGexp  Int       @default(0)
  /// When this row was last confirmed present in-game. Doubles as the staleness
  /// clock and as the left-the-guild tombstone check.
  refreshedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, uuid])
  @@index([guildId, refreshedAt])
}

/// One row per member per day: Hypixel's own expHistory, de-duplicated into a
/// permanent series. The rolling window upstream is only ~7 days, so this table
/// is the only place long-run GEXP tenure and leaderboards can come from.
///
/// Idempotent on (guildId, uuid, day): re-scanning a day overwrites it, which is
/// what makes today's still-climbing value converge rather than double-count.
model GuildGexpDaily {
  id      String   @id @default(cuid())
  guildId String
  uuid    String
  day     DateTime @db.Date
  gexp    Int      @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, uuid, day])
  @@index([guildId, day])
}

/// Audit row per scan attempt. Cheap, and the only way to answer "why is the
/// roster stale" without reading worker logs.
model GuildScan {
  id          String    @id @default(cuid())
  guildId     String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  memberCount Int       @default(0)
  /// UUIDs seen for the first time / no longer present, relative to the cache.
  joined      String[]  @default([])
  left        String[]  @default([])
  error       String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, startedAt])
}

enum ScreeningVerdict {
  /// Clears the bar on every axis the policy checks.
  ACCEPT
  /// Nothing disqualifying, but something a human should look at.
  REVIEW
  /// Fails a rule the policy treats as disqualifying.
  DENY
}

enum ScreeningOutcome {
  /// Screened, no decision yet — the state a REVIEW verdict rests in.
  PENDING
  /// `/g accept` was sent. Says nothing about whether it worked upstream.
  ACCEPTED
  /// Refused, by policy or by a human.
  DENIED
  /// Went stale unanswered, or the player withdrew.
  EXPIRED
  /// Observed joining without a request — an open guild, or an invite.
  JOINED
}

/// One screening per join attempt: who asked, what we found out about them at
/// that moment, and what happened next.
///
/// A row per *attempt*, not per player. Repeat requests are themselves a signal
/// (three tries in a week reads differently from one), the stat block is a
/// point-in-time reading that would be destroyed by an upsert, and the pair is
/// what makes "who did we let in, on what evidence" answerable months later.
///
/// The stat columns duplicate what a ProfileSnapshot would hold, and do so
/// deliberately: a snapshot needs a linked MinecraftAccount row, and an
/// applicant is by definition somebody the platform has never met. These are
/// the numbers as they stood at the door.
model GuildJoinScreening {
  id        String  @id @default(cuid())
  guildId   String
  uuid      String
  ign       String
  /// Resolved via the Hypixel social field or the SkyKings link, when either
  /// knew. Null is ordinary — most applicants arrive unlinked.
  discordId String?

  requestedAt DateTime         @default(now())
  verdict     ScreeningVerdict
  /// 0–100. Higher is riskier; the thresholds that turn it into a verdict are
  /// per-guild policy, so the number is stored and the cut is not.
  riskScore   Int              @default(0)
  /// Machine-readable reason codes (`SCAMMER_FLAGGED`, `NEW_ACCOUNT`, …), in the
  /// order the policy raised them. Rendered to sentences at the surface.
  reasons     String[]         @default([])

  /// Three-valued on purpose: true = listed, false = SkyKings answered and had
  /// nothing, null = we could not find out. Collapsing null into false is how an
  /// outage becomes an all-clear.
  scammer       Boolean?
  scammerReason String?
  /// Which identifier matched — `UUID` or `DISCORD`.
  scammerSource String?

  /// The stat block as it stood at the moment of the request. Every field is
  /// nullable: an applicant with their API off is unreadable, not empty.
  networth       BigInt?
  skillAverage   Float?
  catacombsLevel Float?
  senitherWeight Float?
  skyblockLevel  Float?
  profileName    String?
  firstLoginAt   DateTime?
  lastLoginAt    DateTime?
  /// Everything else worth keeping but not worth a column — slayer levels, the
  /// SkyKings tracker's own figures, the guild they came from, API-visibility
  /// flags. Read by the panel and by later analysis, never by a hot path.
  metrics        Json      @default("{}")

  outcome   ScreeningOutcome @default(PENDING)
  decidedAt DateTime?
  /// `AUTO` for a policy decision, otherwise the deciding staff member's
  /// Discord id. A string rather than a relation: the decider may be the bot.
  decidedBy String?
  /// Set when screening itself failed, so a REVIEW caused by an outage is
  /// distinguishable from one caused by the applicant.
  error     String?
  createdAt DateTime         @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, requestedAt])
  /// "Have they tried before, and what happened?" — the repeat-attempt read.
  @@index([guildId, uuid, requestedAt])
  /// The staff queue: pending reviews, oldest first.
  @@index([guildId, outcome, requestedAt])
}

model GuildConfig {
  id               String   @id @default(cuid())
  guildId          String   @unique
  /// Channels live in GuildChannelBinding, never here. The five `*ChannelId`
  /// columns this model used to carry were dropped in
  /// 20260811150000_drop_legacy_channel_columns, after their values were
  /// backfilled into bindings.
  prefixes         String[] @default(["!"])
  timezone         String   @default("UTC")
  applicationsOpen Boolean  @default(false)
  bridgeSuspended  Boolean  @default(false)
  /// Deprecated. These were the guild's entry bars, checked by screening before
  /// the scam check became the only requirement. Nothing reads them any more —
  /// `/set-recruitment` no longer offers them and the runtime config no longer
  /// carries them — but they are kept rather than dropped: the values are a
  /// record of what a guild once required, and no code path is made correct by
  /// deleting them. Anything genuinely needing an entry bar should add its own
  /// column rather than revive these.
  minWeight        Int?
  minNetworth      BigInt?
  // Platform role -> Discord role id, as `/set-role type:mapping` records it.
  roleMappings     Json     @default("{}")
  features         Json     @default("{}")
  cooldownDefaults Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model BridgePermission {
  id          String           @id @default(cuid())
  guildId     String
  subjectType PermSubjectType
  subjectId   String // role id / discord id / in-game rank name
  capability  BridgeCapability
  allow       Boolean          @default(true)
  createdAt   DateTime         @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, subjectType, subjectId, capability])
  @@index([guildId, capability])
}

model WordlistEntry {
  id        String        @id @default(cuid())
  guildId   String
  pattern   String
  matchType WordMatchType @default(SUBSTRING)
  action    WordAction    @default(BLOCK)
  severity  Int           @default(1)
  enabled   Boolean       @default(true)
  addedById String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, enabled])
  @@index([guildId, action])
}

// ─────────────────────────── Moderation & Support ───────────────────────────

model Infraction {
  id                       String             @id @default(cuid())
  guildId                  String
  targetDiscordId          String?
  targetMinecraftAccountId String?
  type                     InfractionType
  severity                 InfractionSeverity @default(LOW)
  reason                   String
  sourceContext            SourceContext      @default(DISCORD)
  status                   InfractionStatus   @default(OPEN)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  guild   Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actions ModerationAction[]

  @@index([guildId, targetDiscordId, createdAt])
  @@index([guildId, type])
  @@index([guildId, status])
}

model ModerationAction {
  id                       String        @id @default(cuid())
  guildId                  String
  infractionId             String?
  actorDiscordId           String
  targetDiscordId          String?
  targetMinecraftAccountId String?
  type                     ModActionType
  reason                   String
  // Cross-surface mute records both surfaces it swept (COMMANDS.md /mute).
  surfaces                 String[]      @default([])
  durationSeconds          Int?
  expiresAt                DateTime?
  active                   Boolean       @default(true)
  // Which surface the action was issued on. INGAME rows come from parsing
  // Hypixel's own guild-chat notices, so they carry no actor snowflake and are
  // best-effort by nature — the panel labels them rather than mixing them in.
  sourceContext            SourceContext @default(DISCORD)
  createdAt                DateTime      @default(now())

  guild      Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  infraction Infraction? @relation(fields: [infractionId], references: [id], onDelete: SetNull)

  @@index([guildId, targetDiscordId, active])
  @@index([guildId, type, createdAt])
  @@index([guildId, expiresAt])
}

model Ticket {
  id                        String       @id @default(cuid())
  guildId                   String
  /// Per-guild sequence, starting at 1. This is `{num}` in a channel-name or
  /// opening-message template, and it is what staff and members call the ticket
  /// in conversation — a cuid is unusable for that.
  number                    Int          @default(0)
  openerDiscordId           String
  assigneeDiscordId         String?
  categoryId                String?
  status                    TicketStatus @default(OPEN)
  channelId                 String?
  subject                   String?
  /// Free-text reason the member gave, when the category asks for a topic.
  topic                     String?
  /// Answers to the category's questions, keyed by question id. Mutually
  /// exclusive with `topic` in practice: a category asks for one or the other.
  answers                   Json         @default("{}")
  claimedByDiscordId        String?
  claimedAt                 DateTime?
  closeRequestedByDiscordId String?
  closeRequestedAt          DateTime?
  /// Drives the stale and auto-close clocks. Written on every captured message.
  lastMessageAt             DateTime?
  /// First staff message, which is the input to `{avgResponseTime}`. Null until
  /// staff answer — and rendered as "—", never as zero.
  firstStaffReplyAt         DateTime?
  feedbackRating            Int?
  feedbackComment           String?
  transcriptReady           Boolean      @default(false)
  closeReason               String?
  closedAt                  DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  guild    Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  category TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([guildId, openerDiscordId])
  @@index([channelId])
}

/// One captured message in a ticket channel — the transcript store.
///
/// Edits and deletions are recorded rather than applied: a transcript that
/// silently loses a deleted message is worse than no transcript, because it
/// reads as a complete record of a conversation that did not happen that way.
model TicketMessage {
  id               String    @id @default(cuid())
  ticketId         String
  discordMessageId String
  authorDiscordId  String
  /// Denormalised on purpose: the author may leave the server, and a transcript
  /// that renders a bare snowflake for half its lines is not a record anyone can
  /// read a year later.
  authorTag        String
  content          String
  /// Filename, size and content type per attachment, plus the CDN url. The url
  /// expires — Discord signs them now — so the transcript states what was
  /// attached rather than pretending to archive the bytes.
  attachments      Json      @default("[]")
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, discordMessageId])
  @@index([ticketId, createdAt])
}

model Application {
  id                 String            @id @default(cuid())
  guildId            String
  applicantDiscordId String
  minecraftAccountId String?
  answers            Json              @default("{}")
  status             ApplicationStatus @default(SUBMITTED)
  reviewerDiscordId  String?
  decisionReason     String?
  submittedAt        DateTime?
  decidedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, applicantDiscordId])
}

// ─────────────────────────── Community & Engagement ───────────────────────────

model Event {
  id                  String      @id @default(cuid())
  guildId             String
  title               String
  description         String?
  type                EventType   @default(CUSTOM)
  status              EventStatus @default(SCHEDULED)
  startsAt            DateTime
  endsAt              DateTime?
  capacity            Int?
  hostDiscordId       String?
  /// Where the tracker board was published, and the message that is edited in
  /// place as the event runs. The channel is stored rather than resolved from
  /// the `events` slot each pass: a slot rebound mid-event would otherwise
  /// orphan a board nobody can update, and a board that cannot be edited is
  /// worse than one posted in the old channel.
  channelId           String?
  messageId           String?
  /// When the board was last edited. Shown on the board itself, so a reader can
  /// tell a quiet leaderboard from a stalled one.
  boardUpdatedAt      DateTime?
  /// Set once the board has been edited into its result card. A finished event
  /// is otherwise indistinguishable from one whose board is merely overdue, and
  /// the board pass would rewrite the same card every half hour forever.
  boardFinal          Boolean     @default(false)
  // Progression-tracking events drive the sub-hourly snapshot cohort (WORKERS.md §2.5).
  tracksProgression   Boolean     @default(false)
  /// Metric keys this event scores, e.g. `catacombs`, `skill:mining`. Driven off
  /// the parsed snapshot's own keys rather than an enum, so a metric Hypixel
  /// adds needs no migration.
  trackedMetrics      String[]    @default([])
  /// How often the tracker polls participants while the event is LIVE.
  pollIntervalMinutes Int         @default(30)
  /// The mirrored Discord scheduled event, when one was created.
  discordEventId      String?
  reminderState       Json        @default("{}")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  guild     Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rsvps     EventRSVP[]
  scores    EventScore[]
  attendees EventAttendance[]
  snapshots ProfileSnapshot[]

  @@index([guildId, status, startsAt])
  @@index([status, boardUpdatedAt])
}

/// One person who actually turned up, which is a different question from what
/// they said they would do — `EventRSVP` records the promise, this records the
/// event.
///
/// Two sources, and the distinction is load-bearing. `TRACKED` rows are written
/// when the event finishes, from the participants the poller actually scored:
/// free, objective, and blind to anyone without a verified account. `MARKED`
/// rows are a person's judgement from the panel, which is the only way an
/// unlinked member or a walk-in who never RSVP'd is ever recorded. Re-marking
/// replaces the `MARKED` set and leaves the `TRACKED` rows alone, so a correction
/// never silently discards what the tracker saw.
///
/// Keyed by Discord id rather than uuid: attendance is a fact about a member of
/// this server, and the achievement family it feeds counts people, not profiles.
model EventAttendance {
  id         String           @id @default(cuid())
  eventId    String
  discordId  String
  source     AttendanceSource @default(MARKED)
  /// Who marked it, for a `MARKED` row. Null when the tracker wrote it.
  recordedBy String?
  recordedAt DateTime         @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, discordId])
  @@index([discordId])
}

enum AttendanceSource {
  TRACKED
  MARKED
}

/// One participant's standing in one metric of one event.
///
/// `baseline` is captured on the first poll after the event goes LIVE and never
/// moves again; `delta` is the score, stored rather than computed so the board
/// can order by it in the database instead of loading every row to sort in
/// memory. Keyed by uuid rather than by Discord id because the figure comes from
/// a SkyBlock profile — a member who relinks keeps their progress.
model EventScore {
  id        String   @id @default(cuid())
  eventId   String
  discordId String
  uuid      String
  metric    String
  baseline  Float
  current   Float
  delta     Float    @default(0)
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, uuid, metric])
  @@index([eventId, metric, delta])
}

model EventRSVP {
  id          String    @id @default(cuid())
  eventId     String
  discordId   String
  state       RSVPState @default(GOING)
  respondedAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, discordId])
  @@index([eventId, state])
}

model LFGPost {
  id                String      @id @default(cuid())
  guildId           String
  authorDiscordId   String
  activity          LFGActivity @default(OTHER)
  details           String?
  slotsTotal        Int         @default(5)
  // Denormalized count of `members`, kept in step on every join/leave so the
  // list view can sort and filter without loading the roster of every post.
  slotsFilled       Int         @default(1)
  /// Discord ids holding a slot, author first (COMMANDS.md /runs roster).
  members           String[]    @default([])
  status            LFGStatus   @default(OPEN)
  expiresAt         DateTime?
  /// A short headline the author writes, e.g. "F7 carries, need healer".
  /// Separate from `details` because one goes in the embed title and the other
  /// in its body, and squashing them means the list view has nothing short to
  /// show.
  title             String?
  /// Where the post was published, so the embed can be edited in place as
  /// people join and leave rather than leaving a stale roster on screen.
  /// Nullable because publishing can fail — a post that exists with no message
  /// is recoverable; a post that only exists as a message is not.
  channelId         String?
  messageId         String?
  /// The perm this post's roster was autofilled from, when it was. Kept for the
  /// same reason a screening keeps its inputs: "why were those four already in
  /// the party" should be answerable later.
  permGroupId       String?
  /// Closure is recorded, not inferred from `status`: "closed by the author at
  /// 9pm" and "expired quietly overnight" are both CLOSED-ish states that mean
  /// different things when someone asks what happened to a run.
  closedAt          DateTime?
  closedByDiscordId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, activity, status])
}

enum PermStatus {
  ACTIVE
  DISBANDED
}

/// A "perm" — a permanent party. The standing roster people run an activity with,
/// as opposed to `LFGPost`, which is one advertisement for one run.
///
/// Disbanding is a status change, not a delete: a perm's history is the only
/// record of who ran with whom, and the roster is worth keeping after the party
/// stops running together.
model PermGroup {
  id             String      @id @default(cuid())
  guildId        String
  ownerDiscordId String
  name           String
  activity       LFGActivity @default(OTHER)
  status         PermStatus  @default(ACTIVE)
  /// The perm `/lfg perm:true` autofills from when no perm is named. At most one
  /// per (guild, owner, activity) — enforced by a partial unique index in the
  /// migration, since Prisma cannot express a filtered unique constraint.
  isDefault      Boolean     @default(false)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members PermMember[]

  @@index([guildId, ownerDiscordId, status])
  @@index([guildId, activity, status])
}

/// One seat in a perm.
///
/// `ign` is the required identifier and `discordId`/`uuid` are both optional,
/// which is the opposite of most tables here. A perm is formed in-game, where
/// most of the guild has no linked Discord account and the only thing anyone
/// knows about a teammate is what they type. Requiring a link would make the
/// command unusable for the people it is for.
model PermMember {
  id          String   @id @default(cuid())
  permGroupId String
  discordId   String?
  uuid        String?
  ign         String
  /// Free-form, validated per activity in `@sbr/perms`. Not an enum: Skyblock
  /// class and role vocabulary changes far more often than we want migrations.
  role        String
  slot        Int      @default(0)
  addedAt     DateTime @default(now())

  permGroup PermGroup @relation(fields: [permGroupId], references: [id], onDelete: Cascade)

  @@unique([permGroupId, ign, role])
  @@index([permGroupId, slot])
}

/// Where a unit of XP came from. The set is closed on purpose: every source
/// needs a weight, a cap and a place in the `/standing` breakdown, so adding one
/// is a deliberate change rather than a free-form string somebody invents.
enum XpSource {
  /// Hypixel guild experience, from GuildGexpDaily.
  GEXP
  DISCORD_MESSAGE
  GUILD_CHAT_MESSAGE
  /// Days as a platform member. Awarded per day, not as a lump.
  TENURE
  COMMAND_USAGE
  /// Event attendance, from EventRSVP.
  EVENT
  /// A milestone's configured reward, credited once when it is announced.
  MILESTONE
  /// Staff adjustment, positive or negative. Always carries a reason in `meta`.
  MANUAL
}

/// Append-only XP ledger. Every award records the raw quantity it came from and
/// the weight applied, so a balance is explainable ("2,400 GEXP × 0.05") and
/// rebuildable from scratch — a weight change re-derives history rather than
/// silently disagreeing with it.
model XpEvent {
  id        String   @id @default(cuid())
  guildId   String
  discordId String
  source    XpSource
  /// Awarded XP, after weight and caps. Signed: MANUAL may take XP away.
  amount    Int
  /// What the amount was computed from — GEXP earned, messages sent, days.
  rawValue  Int      @default(0)
  day       DateTime @db.Date
  /// Idempotency key, e.g. `gexp:<uuid>:2026-08-09`. Null for awards that are
  /// genuinely one-off (MANUAL), where re-running is not a concern. Unique when
  /// present, which is what makes a re-run of the aggregation job a no-op
  /// instead of a second credit.
  dedupeKey String?  @unique
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, discordId, day])
  @@index([guildId, source, day])
}

/// Denormalized standing, rebuilt from the ledger by the xp-aggregate job. This
/// is what `/standing` and the leaderboards read: a command must never sum the
/// ledger live, or a busy guild turns a 60 ms reply into a table scan.
/// A level a member has climbed to, queued for announcement.
///
/// A row rather than an event, for the same reason milestones are: detection
/// happens in the workers and the announcement happens in the member bot, so a
/// bot that is down during the nightly pass must find the backlog waiting
/// rather than have missed a broadcast. The unique key is the level reached —
/// a rebuild that recomputes the same climb writes the same row.
model XpLevelUp {
  id        String   @id @default(cuid())
  guildId   String
  discordId String
  fromLevel Int
  toLevel   Int
  totalXp   Int
  announced Boolean  @default(false)
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId, toLevel])
  @@index([announced, createdAt])
}

/// A reminder a member set for themselves with `/remind`.
///
/// Durable rather than an in-process timer: the useful reminders are hours or
/// days out, and a deploy in the middle of one must not swallow it. The sweeper
/// delivers what is due and flips `delivered` afterwards, so a crash mid-post
/// repeats a reminder rather than losing it.
///
/// `channelId` is the channel it was set in. A channel that has since been
/// deleted simply fails to deliver, which the sweeper reports and retries.
model Reminder {
  id        String   @id @default(cuid())
  guildId   String
  discordId String
  channelId String
  text      String
  dueAt     DateTime
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([delivered, dueAt])
  @@index([guildId, discordId, delivered])
}

model XpBalance {
  id          String    @id @default(cuid())
  guildId     String
  discordId   String
  totalXp     Int       @default(0)
  level       Int       @default(0)
  /// Per-source totals, keyed by XpSource. Denormalized for the breakdown so one
  /// row answers the whole of `/standing`.
  bySource    Json      @default("{}")
  tenureDays  Int       @default(0)
  lastAwardAt DateTime?
  updatedAt   DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId])
  @@index([guildId, totalXp])
}

/// Panel-configured weight and anti-abuse limits per source. A missing row means
/// the source is disabled — a guild that has configured nothing earns nothing,
/// which is the safe direction for a system people will try to farm.
model XpSourceConfig {
  id          String   @id @default(cuid())
  guildId     String
  source      XpSource
  enabled     Boolean  @default(true)
  /// XP per unit of `rawValue`. Fractional (GEXP is thousands per day, XP is not).
  weight      Float    @default(1)
  /// Most XP this source may award one member in one day. Null = uncapped, which
  /// only makes sense for sources bounded by something else (GEXP, TENURE).
  dailyCap    Int?
  /// Minimum gap between two countable actions, in seconds. Spam control for the
  /// message sources; ignored by the aggregated ones.
  cooldownSec Int      @default(0)
  /// Minimum message length to count at all. Defeats "a" × 200.
  minLength   Int      @default(0)
  updatedAt   DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, source])
}

/// Raw per-day activity counters. The hot path increments these (via Redis,
/// drained by a job) and XP is derived from them afterwards — never awarded
/// inline from a message event. That split is what makes caps enforceable: a
/// counter can be re-read and re-weighted, an award already handed out cannot.
model ActivityDaily {
  id                String   @id @default(cuid())
  guildId           String
  discordId         String
  day               DateTime @db.Date
  discordMessages   Int      @default(0)
  guildChatMessages Int      @default(0)
  commandsUsed      Int      @default(0)
  /// `/g online` hits. The playtime proxy — presence is sampled, never measured.
  presenceSamples   Int      @default(0)
  updatedAt         DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId, day])
  @@index([guildId, day])
}

model NotificationSubscription {
  id        String   @id @default(cuid())
  guildId   String
  discordId String
  category  String // mayor | firesale | bingo | events | ...
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId, category])
  @@index([guildId, category])
}

// ─────────────────────────── Progression & Analytics ───────────────────────────

model ProfileSnapshot {
  id                 String         @id @default(cuid())
  minecraftAccountId String
  profileId          String
  // Day bucket + intra-day sequence: normal snapshots use seq 0 (one/day); the
  // event-tracked cohort writes many per day (seq 1..N) for live leaderboards.
  captureDate        DateTime       @db.Date
  seq                Int            @default(0)
  capturedAt         DateTime       @default(now())
  source             SnapshotSource @default(SCHEDULED)
  eventId            String? // set for EVENT_TRACKED snapshots
  networth           BigInt?
  skillAverage       Float?
  catacombsLevel     Float?
  /// Total slayer XP across all bosses. BigInt because a maxed account clears
  /// nine figures, and the leaderboard ranks on the sum, not the tiers.
  slayerXp           BigInt?
  senitherWeight     Float?
  /// SkyBlock Level, fractional (`leveling.experience / 100`). The headline
  /// number on the profile card and a metric in its own right: skills plateau
  /// and networth swings with the market, but levelling advances for anyone who
  /// plays. Null when the profile hid its `leveling` section — not zero.
  skyblockLevel      Float?
  metrics            Json           @default("{}")
  createdAt          DateTime       @default(now())

  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  event            Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  milestones       Milestone[]

  @@unique([minecraftAccountId, profileId, captureDate, seq])
  @@index([minecraftAccountId, capturedAt]) // progression over time
  @@index([eventId, minecraftAccountId, capturedAt]) // event leaderboard: latest per member
}

/// A threshold a guild considers worth recognising.
///
/// Staff-editable so a guild can set its own bar — the built-in defaults in
/// `@sbr/jobs` are what a guild with no definitions is measured against, not a
/// floor it has to keep.
model MilestoneDefinition {
  id          String          @id @default(cuid())
  guildId     String
  /// Stable identifier, e.g. "networth:10b". The detector keys replays off this
  /// rather than the label, so renaming a milestone never re-announces it.
  key         String
  label       String
  description String?
  type        MilestoneType
  /// Which snapshot field to compare — must be one the detector knows.
  metric      String
  threshold   BigInt
  /// Guild XP credited once, when the milestone is announced. 0 = recognition
  /// only, which is the default: a guild opts into paying for progress.
  xpReward    Int             @default(0)
  announce    Boolean         @default(true)
  enabled     Boolean         @default(true)
  /// Editorial weight, not arithmetic: what the guild considers a big deal.
  /// Ordering within a category and the badge colour both come from this.
  tier        AchievementTier @default(BRONZE)
  /// A single emoji rendered before the label. Null renders the tier's own.
  icon        String?
  /// Not listed while locked — a member reads about it when they earn it. It
  /// still detects, announces and pays like any other.
  hidden      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  guild      Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@unique([guildId, key])
  @@index([guildId, enabled])
}

model Milestone {
  id                 String        @id @default(cuid())
  minecraftAccountId String
  guildId            String?
  /// The definition that recognised this, when one did. Null for a milestone
  /// from the built-in defaults, and SetNull on delete — deleting a definition
  /// must not erase the fact that someone reached it.
  definitionId       String?
  /// Denormalized at detection time so the announcer can mention a person
  /// without re-resolving a link that may since have changed.
  discordId          String?
  type               MilestoneType
  metric             String
  thresholdValue     BigInt
  achievedAt         DateTime      @default(now())
  snapshotId         String?
  announced          Boolean       @default(false)
  createdAt          DateTime      @default(now())

  minecraftAccount MinecraftAccount     @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  snapshot         ProfileSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  definition       MilestoneDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)

  @@unique([minecraftAccountId, type, metric, thresholdValue])
  @@index([minecraftAccountId, achievedAt])
  /// The announcer's sweep: unannounced rows, oldest first.
  @@index([announced, achievedAt])
}

/// A target a member set for themselves, and the platform's record of whether
/// they got there.
///
/// Unique on (member, metric): a goal is a current intention, not a ledger, so
/// setting a new networth target replaces the old one rather than queueing
/// behind it. What survives replacement is the *achievement* — the goal-check
/// job writes a Milestone row when a target is met, and that table is the one
/// built to remember things.
model ProgressionGoal {
  id                 String    @id @default(cuid())
  guildId            String
  minecraftAccountId String
  /// Denormalised at set time so the announcer can mention a member without
  /// re-resolving a link that may since have moved, exactly as Milestone does.
  discordId          String?
  /// A `ProgressMetric` — the four tracks `/progress` charts.
  metric             String
  /// BigInt because networth targets run to trillions; the other three metrics
  /// are small integers and lose nothing by sharing the column type.
  target             BigInt
  /// Where they were when they set it, so a progress bar has a floor. Null for
  /// a member with no snapshot yet.
  startValue         BigInt?
  achievedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  guild            Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@unique([guildId, minecraftAccountId, metric])
  /// `/goal` — one member's list.
  @@index([guildId, minecraftAccountId])
  /// The checker's sweep: everything still outstanding, paged by id.
  @@index([achievedAt, id])
}

model CommandUsage {
  id        String         @id @default(cuid())
  guildId   String?
  discordId String?
  surface   CommandSurface
  command   String
  args      Json?
  success   Boolean        @default(true)
  latencyMs Int?
  invokedAt DateTime       @default(now())

  @@index([guildId, command, invokedAt])
  @@index([surface, invokedAt])
}

model WorkerJobLog {
  id            String    @id @default(cuid())
  queue         String
  jobId         String?
  type          String
  status        JobStatus @default(QUEUED)
  attempts      Int       @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  error         String?
  resultSummary Json?
  createdAt     DateTime  @default(now())

  @@index([queue, status, createdAt])
  @@index([type, createdAt])
}

// ─────────────────────────── Analytics (ANALYTICS.md) ───────────────────────────

enum MetricPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

/// Raw fact table. Producers append to the `buf:analytics` Redis Stream on the
/// hot path; the `analytics-ingest` job drains it into here in batches, so a
/// slow database never shows up as command latency.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  /// Internal Guild.id, or null for platform-wide events.
  guildId   String?
  discordId String?
  /// Free-form rather than the CommandSurface enum: analytics also records
  /// "SYSTEM" events that no command surface produced.
  surface   String
  type      String
  props     Json     @default("{}")
  /// When the event happened, which is not when it was ingested — rollups
  /// bucket on this so a backlogged drain still lands in the right period.
  ts        DateTime
  createdAt DateTime @default(now())

  @@index([guildId, type, ts])
  @@index([ts])
}

/// Aggregated counts per (guild, metric, period, bucket, dimensions).
///
/// Deliberately has no unique constraint: rollups are rebuilt by deleting the
/// partition and re-inserting it (ANALYTICS.md §3), which is both simpler than
/// an upsert and the documented recovery path. A unique key over a nullable
/// `guildId` would also not behave, since Postgres treats NULLs as distinct.
model MetricRollup {
  id          String       @id @default(cuid())
  guildId     String?
  metric      String
  period      MetricPeriod
  bucketStart DateTime
  dims        Json         @default("{}")
  count       Int          @default(0)
  computedAt  DateTime     @default(now())

  @@index([guildId, metric, period, bucketStart])
  @@index([period, bucketStart])
}

/// The one ticket panel a guild posts, and where it lives.
///
/// One row per guild: a second panel would mean two places to open the same
/// ticket, and the message id here is what lets the bot edit the posted panel
/// in place instead of leaving a stale copy behind whenever the types change.
/// Per-guild ticket behaviour, mirroring the discord-tickets settings model.
model TicketSettings {
  guildId               String   @id
  /// Whether messages are captured at all. Off means no transcript exists, which
  /// the panel says plainly rather than showing an empty one.
  archiveEnabled        Boolean  @default(true)
  logChannelId          String?
  /// Roles that may not open a ticket. Checked first, so a blocked member is
  /// told they are blocked rather than told they failed some other rule.
  blocklistRoleIds      String[] @default([])
  primaryColor          String   @default("INFO")
  successColor          String   @default("SUCCESS")
  errorColor            String   @default("DANGER")
  footer                String?
  /// Silence after which a ticket is considered stale. Null disables the clock.
  staleAfterMinutes     Int?
  /// How long a pending-closure ticket waits before the sweep closes it.
  autoCloseAfterMinutes Int      @default(720)
  closeButton           Boolean  @default(true)
  claimButton           Boolean  @default(true)
  /// Per-weekday open/close times, in the guild's timezone. Outside them a
  /// member is told when staff are back rather than left waiting in silence.
  workingHours          Json     @default("{}")
  updatedAt             DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

/// One kind of ticket a member can open.
///
/// A model rather than the fixed enum it replaced: the fields a guild actually
/// needs to vary — staff roles, parent channel, limits, questions — are all
/// per-category, and an enum could carry none of them.
model TicketCategory {
  id                  String   @id @default(cuid())
  guildId             String
  key                 String
  name                String
  /// Shown in the select menu, where Discord caps the description at 100 chars.
  description         String   @default("")
  emoji               String?
  position            Int      @default(0)
  enabled             Boolean  @default(true)
  /// `{num}`, `{name}` and `{nick}` are expanded at creation time.
  channelNameTemplate String   @default("ticket-{num}")
  parentChannelId     String?
  staffRoleIds        String[] @default([])
  /// The member needs *all* of these, not any — matching the reference
  /// implementation, and the stricter of the two readings.
  requiredRoleIds     String[] @default([])
  pingRoleIds         String[] @default([])
  openingMessage      String   @default("")
  image               String?
  claiming            Boolean  @default(true)
  cooldownSeconds     Int?
  /// Open tickets one member may hold in this category.
  memberLimit         Int      @default(1)
  /// Open tickets the category may hold at once. Defaults to 50 because Discord
  /// caps a channel category at 50 channels, and the 51st create fails.
  totalLimit          Int      @default(50)
  slowModeSeconds     Int?
  requireTopic        Boolean  @default(false)
  /// Up to five, because a Discord modal takes five inputs. Questions take
  /// precedence over `requireTopic` when both are set.
  questions           Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([guildId, key])
  @@index([guildId, enabled])
}

/// A posted message members open tickets from. Many per guild.
model TicketPanel {
  id           String           @id @default(cuid())
  guildId      String
  name         String
  channelId    String?
  /// The panel message, so a change edits in place rather than reposting.
  messageId    String?
  title        String           @default("Support")
  description  String?
  image        String?
  thumbnail    String?
  style        TicketPanelStyle @default(BUTTONS)
  /// Category keys, in the order they appear on the panel.
  categoryKeys String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

enum TicketPanelStyle {
  BUTTONS
  SELECT
}

/// A canned reply, optionally auto-sent when a message matches its pattern.
model TicketTag {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  content     String
  /// Case-insensitive, multiline regex. Compiled defensively — a pattern that
  /// no longer compiles disables the tag rather than breaking message capture.
  autoPattern String?
  scope       TagScope @default(TICKET)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
}
