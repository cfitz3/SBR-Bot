{
  "name": "@sbr/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "node dist/seed.js",
    "studio": "prisma studio",
    "build": "prisma generate && tsc -b",
    "clean": "tsc -b --clean",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sbr/community": "*",
    "@sbr/env": "*",
    "@sbr/guild-config": "*",
    "@sbr/jobs": "*",
    "@sbr/leaderboards": "*",
    "@sbr/perms": "*",
    "@sbr/screening": "*",
    "@sbr/tickets": "*",
    "@sbr/xp": "*",
    "@sbr/roles": "*",
    "@sbr/shared-types": "*",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
